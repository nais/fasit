enum RolloutStatus {
  UNKNOWN
  CREATED
  PENDING
  DEPLOYED
  FAILED
}

type LogLine {
  id: ID!
  timestamp: Time!
  message: String!
}

type Status {
  environmentID: ID!
  version: String!
  status: RolloutStatus!
  created: Time!
  lastModified: Time!
  log: [LogLine!]!
}

type Subscription {
  logs(environmentID: ID!, featureName: String!, lastLogID: String): LogLine!
}
