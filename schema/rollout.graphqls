type Rollout {
  id: ID!
  version: String!
  created: Time!
  completed: Time
  status: RolloutStatus!

  events: [RolloutEvent!]!
}

type RolloutEvent {
  id: ID!
  failure: Boolean!
  message: String!
  created: Time!
}

extend type Query {
  rollouts(feature: String!): [Rollout!]!
  rollout(id: ID!): Rollout!
}
