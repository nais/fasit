type Rollout {
  id: ID!
  feature: Feature!
  status: RolloutStatus!
  changeset: RolloutChangeset!
  created: Time!
  lastModified: Time!
  events: [RolloutEvent!]!
}

enum RolloutEventType {
  PROCESSED
  IN_PROGRESS
  HELM_COMPLETED
  FAILED
  ROLLED_BACK
  SUCCESS
}

type RolloutChangeset {
  New: RawMessage!
  Old: RawMessage
}
type RolloutEvent {
  id: ID!
  type: RolloutEventType!
  data: RawMessage!
  created: Time!
}

extend type Query {
  rollout(id: ID!): Rollout!
}
