{
	"$id": "https://fasit.nais.io/schema/feature",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"properties": {
		"autoInstall": {
			"description": "AutoInstall is the list of environments this feature can be auto-installed in.",
			"items": {
				"enum": [
					"management",
					"tenant",
					"onprem"
				],
				"type": "string"
			},
			"type": "array"
		},
		"chart": {
			"description": "Chart name if using helm charts or full url if using CRI image chart.",
			"type": "string"
		},
		"config": {
			"description": "Config is the list of configuration options for the feature.",
			"patternProperties": {
				".*": {
					"additionalProperties": false,
					"properties": {
						"description": {
							"type": "string"
						},
						"displayName": {
							"type": "string"
						},
						"ignoreKind": {
							"items": {
								"type": "string"
							},
							"type": "array"
						},
						"required": {
							"type": "boolean"
						},
						"secret": {
							"type": "boolean"
						},
						"type": {
							"enum": [
								"string",
								"int",
								"bool",
								"string_array"
							],
							"type": "string"
						}
					},
					"required": [
						"type"
					],
					"type": "object"
				}
			},
			"type": "object"
		},
		"dependsOn": {
			"description": "DependsOn defines the features that this feature depends on.",
			"items": {
				"additionalProperties": false,
				"properties": {
					"allOf": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"anyOf": {
						"items": {
							"type": "string"
						},
						"type": "array"
					}
				},
				"type": "object"
			},
			"type": "array"
		},
		"environmentKinds": {
			"description": "EnvironmentKinds is the list of environments this feature can be used in.",
			"items": {
				"enum": [
					"management",
					"tenant",
					"onprem"
				],
				"type": "string"
			},
			"type": "array"
		},
		"mapping": {
			"description": "Mapping is the list of mappings from environment values for the feature.",
			"patternProperties": {
				".*": {
					"additionalProperties": false,
					"oneOf": [
						{
							"required": [
								"value"
							],
							"title": "value"
						},
						{
							"required": [
								"template"
							],
							"title": "template"
						}
					],
					"properties": {
						"description": {
							"type": "string"
						},
						"displayName": {
							"type": "string"
						},
						"ignoreKind": {
							"items": {
								"type": "string"
							},
							"type": "array"
						},
						"template": {
							"type": "string"
						},
						"value": true
					},
					"type": "object"
				}
			},
			"type": "object"
		},
		"repo": {
			"description": "Repo is the repository where the helm chart is located.",
			"type": "string"
		},
		"rolloutSource": {
			"description": "RolloutSource is the org and name of repositories which can trigger a rollout.",
			"items": {
				"additionalProperties": false,
				"properties": {
					"org": {
						"type": "string"
					},
					"repo": {
						"type": "string"
					}
				},
				"required": [
					"org",
					"repo"
				],
				"type": "object"
			},
			"type": "array"
		},
		"source": {
			"description": "Source should be the URL to the helm chart source code.",
			"type": "string"
		},
		"timeout": {
			"description": "Timeout is the amount of time helm should wait for the feature to be ready. Defaults to 5m0s",
			"pattern": "^(\\d+h)?(\\d+m)?(\\d+s)?$",
			"type": "string"
		},
		"version": {
			"description": "Version of the chart.",
			"type": "string"
		}
	},
	"required": [
		"chart",
		"version",
		"source",
		"environmentKinds"
	],
	"type": "object"
}