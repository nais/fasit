{
	"$id": "https://fasit.nais.io/schema/feature-yaml",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"properties": {
		"dependencies": {
			"items": {
				"additionalProperties": false,
				"properties": {
					"allOf": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"anyOf": {
						"items": {
							"type": "string"
						},
						"type": "array"
					}
				},
				"type": "object"
			},
			"type": "array"
		},
		"environmentKinds": {
			"items": {
				"enum": [
					"management",
					"tenant",
					"onprem",
					"legacy"
				],
				"type": "string"
			},
			"type": "array"
		},
		"timeout": {
			"pattern": "^(\\d+h)?(\\d+m)?(\\d+s)?$",
			"type": "string"
		},
		"values": {
			"additionalProperties": {
				"additionalProperties": false,
				"anyOf": [
					{
						"required": [
							"computed"
						],
						"title": "computed"
					},
					{
						"required": [
							"config"
						],
						"title": "config"
					}
				],
				"properties": {
					"computed": {
						"additionalProperties": false,
						"properties": {
							"template": {
								"type": "string"
							}
						},
						"type": "object"
					},
					"config": {
						"additionalProperties": false,
						"properties": {
							"secret": {
								"type": "boolean"
							},
							"type": {
								"enum": [
									"string",
									"int",
									"bool",
									"string_array"
								],
								"type": "string"
							}
						},
						"required": [
							"type"
						],
						"type": "object"
					},
					"description": {
						"type": "string"
					},
					"displayName": {
						"type": "string"
					},
					"ignoreKind": {
						"items": {
							"enum": [
								"management",
								"tenant",
								"onprem",
								"legacy"
							],
							"type": "string"
						},
						"type": "array"
					},
					"required": {
						"type": "boolean"
					}
				},
				"type": "object"
			},
			"type": "object"
		}
	},
	"required": [
		"environmentKinds"
	],
	"type": "object"
}