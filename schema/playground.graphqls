type Playground {
	result: String
	errors: [String!]!
}

input PlaygroundInput {
	tenantSlug: String!
	envSlug: String!
	featureName: String
	showSecrets: Boolean
	includeChartDefaults: Boolean
	includeUnsetConfig: Boolean
	code: String!
}

extend type Mutation {
	playground(input: PlaygroundInput!): Playground!
}
