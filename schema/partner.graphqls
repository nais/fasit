type Partner {
    id: ID!
    name: String!
    description: String
    created: Time!
    lastModified: Time!
}
type Query {
    partners: [Partner!]!
}
input PartnerCreate {
    name: String!
    description: String
}
type Mutation {
    partnerCreate(partner: PartnerCreate!): Partner!
}
extend type Query {
    """
    partner returns the given partner.
    """
    partner(
        "id of the requested partner."
        id: ID!
    ): Partner!
}
