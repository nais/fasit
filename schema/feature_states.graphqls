type FeatureState {
  feature: Feature!
  enabled: Boolean!
  created: Time
  lastModified: Time
  missingDependencies: [Feature!]!
  configuration: EnvConfig!
}

extend type Mutation {
  featureStateSave(
    envID: ID!
    enabled: Boolean!
    feature: String!
  ): FeatureState!
}

extend type Query {
  featureState(envID: ID!, feature: String!): FeatureState!
}
