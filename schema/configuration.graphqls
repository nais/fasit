enum ConfigType {
  STRING
  INT
  BOOL
  STRING_ARRAY
}

type ComputedValue {
  value: Value!
  content: RawMessage
}

"""
Configurations contains configuration and computed values for one feature
"""
type Configurations {
  configuration: [Configuration!]!
  computed: [ComputedValue!]!
}

enum ConfigSource {
  GLOBAL
  ENV
  HELM
}

type Configuration {
  id: ID
  value: Value!
  content: RawMessage
  created: Time!
  source: ConfigSource!
}

input NewConfiguration {
  environmentID: ID
  feature: String!
  description: String
  key: String!
  value: RawMessage!
}

input UpdateConfiguration {
  description: String
  value: RawMessage!
}

extend type Query {
  configuration(feature: String!, envID: ID): Configurations!
  helmValues(feature: String!, envID: ID!): RawMessage!
}

extend type Mutation {
  configurationCreate(configuration: NewConfiguration!): Configuration!
  configurationUpdate(
    id: ID!
    configuration: UpdateConfiguration!
  ): Configuration!
  configurationDelete(id: ID!): Boolean!
}
