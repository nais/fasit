type Feature {
  name: String!
  chart: String!
  version: String!
  repo: String!
  source: String!
  dependsOn: [Dependency!]!
  config: RawMessage!
  environmentKinds: [EnvironmentKind!]!
}

type Dependency {
    anyOf: [String!]!
    allOf: [String!]!
}

extend type Query {
  features(kind: EnvironmentKind): [Feature!]!
}
