type Tenant {
  id: ID!
  name: String!
  description: String
  environments: [Environment!]!
  created: Time!
  lastModified: Time!
}

type Query {
  tenants: [Tenant!]!
}

input TenantCreate {
  name: String!
  description: String
}

type Mutation {
  tenantCreate(tenant: TenantCreate!): Tenant!
}

extend type Query {
  """
  tenant returns the given tenant.
  """
  tenant("id of the requested tenant." id: ID, slug: String): Tenant!
}
