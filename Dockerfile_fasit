ARG GO_VERSION=1.26

FROM golang:${GO_VERSION} AS builder

WORKDIR /workspace
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . /workspace

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -ldflags "-X github.com/nais/fasit/internal/fasit.Version=$(git describe --tags --always --dirty 2>/dev/null || echo unknown)" -o fasit ./cmd/fasit

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /

COPY --from=builder /workspace/fasit /usr/local/bin/fasit

ENTRYPOINT ["/usr/local/bin/fasit"]
