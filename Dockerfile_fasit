FROM golang:1.18-alpine as builder

RUN apk add --no-cache git

WORKDIR /workspace
COPY go.* ./
RUN go version
RUN go mod download

COPY . /workspace

# Build
RUN CGO_ENABLED=0 go build -a -o fasit ./cmd/fasit

FROM alpine
WORKDIR /

COPY --from=builder /workspace/fasit .
USER 65532:65532

ENTRYPOINT ["/fasit"]
