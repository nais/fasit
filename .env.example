LOG_LEVEL=debug
HTTP_BIND_ADDRESS=127.0.0.1:8080
GRPC_BIND_ADDRESS=127.0.0.1:4444
FASIT_DBCONN_STRING=postgres://postgres:postgres@localhost:5432/fasit?sslmode=disable
GCP_PROJECT_ID=nais-local-dev
INSECURE_SKIP_PROXY=true
INSECURE_SKIP_TOKEN_CHECK=true
IAP_AUDIENCE=
SLACK_API_TOKEN=
SLACK_CHANNEL_FEATURE_ALERTS=
GH_PEM=

# Local development: run an in-process fake naisd instead of Pub/Sub + naisd.
FASIT_FAKE_NAISD=true
# Mirror the old naisd-all.sh demo mix: prod deploys fail, staging has no agent.
FASIT_FAKE_NAISD_FAILING_ENVS=test-partner/prod
FASIT_FAKE_NAISD_UNHEALTHY_ENVS=test-partner/staging
