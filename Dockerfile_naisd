ARG GO_VERSION=1.26

FROM golang:${GO_VERSION} AS builder

WORKDIR /workspace
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . /workspace

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o naisd ./cmd/naisd

FROM alpine:3 AS helm
ARG HELM_VERSION=3.17.3
RUN wget -qO- https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz | tar xz

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /

COPY --from=helm /linux-amd64/helm /usr/local/bin/helm
COPY --from=builder /workspace/naisd .

ENTRYPOINT ["/naisd"]
