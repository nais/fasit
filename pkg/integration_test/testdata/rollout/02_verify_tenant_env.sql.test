SELECT
  t.name AS tenant_name,
  t.ci AS tenant_ci,

  e.name AS name,
  e.ci AS ci
FROM tenants t
JOIN environments e ON e.tenant_id = t.id
ORDER BY e.name


RETURNS

[
  {
    "tenant_name": "tenant1",
    "tenant_ci": true,
    "name": "env_tenant",
    "ci": true
  },
  {
    "tenant_name": "tenant1",
    "tenant_ci": true,
    "name": "management",
    "ci": true
  }
]
