
# Even tough nonci doesn't have the feature available until it has rolled out, there's nothing
# stopping us from configuring and enabling it.

{{ $tenantID := .Tenant.tenant1.Env.e1.ID }}
{{ $mgmtID := .Tenant.tenant1.Env.management.ID }}
{{ $nonciID := .Tenant.tenant1.Env.nonci.ID }}
{{ $keys := list "myValue" "nested.key" "nested.computed.key" }}

mutation {
	{{ range $i, $key := $keys }}
		tc_{{ $i }}: configurationCreate(configuration: {environmentID: {{ $tenantID | quote}}, feature:"moved", key: {{ $key | quote }}, value: {{ cat $key "value" | quote }}}) {
			source
		}
		mc_{{ $i }}: configurationCreate(configuration: {environmentID: {{ $mgmtID | quote}}, feature:"moved", key: {{ $key | quote }}, value: {{ cat $key "value2" | quote }}}) {
			source
		}
		nonci_{{ $i }}: configurationCreate(configuration: {environmentID: {{ $nonciID | quote}}, feature:"moved", key: {{ $key | quote }}, value: {{ cat $key "value3" | quote }}}) {
			source
		}

		glob_{{ $i }}: configurationCreate(configuration: {feature:"moved", key: {{ $key | quote }}, value: {{ cat $key "glob_value" | quote }}}) {
			source
		}
	{{ end }}
  featureStateSave(envID: "{{ $tenantID }}", enabled: true, feature: "moved") {
    enabled
  }
  mgmt: featureStateSave(envID: "{{ $mgmtID }}", enabled: true, feature: "moved") {
    enabled
  }
  nonci: featureStateSave(envID: "{{ $nonciID }}", enabled: true, feature: "moved") {
    enabled
  }
}

RETURNS

OPTION data.featureStateSave.id=IGNORE

ENDOPTS

{
	"data": {
		{{ range $i, $key := $keys }}
			"tc_{{ $i }}": {
				"source": "ENV"
			},
			"mc_{{ $i }}": {
				"source": "ENV"
			},
			"nonci_{{ $i }}": {
				"source": "ENV"
			},
			"glob_{{ $i }}": {
				"source": "GLOBAL"
			},
		{{ end }}

		"featureStateSave": {
			"enabled": true
		},
		"mgmt": {
			"enabled": true
		},
		"nonci": {
			"enabled": true
		}
	}
}
