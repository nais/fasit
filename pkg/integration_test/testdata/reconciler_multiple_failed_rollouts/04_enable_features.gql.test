mutation {
  testing: featureStateSave(envID: "{{ .Tenant.tenant23.Env.testing.ID }}", enabled: true, feature: "feature1") {
    enabled
  }

  mgmt: featureStateSave(envID: "{{ .Tenant.tenant23.Env.management.ID }}", enabled: true, feature: "feature1") {
    enabled
  }

  nonci: featureStateSave(envID: "{{ .Tenant.tenant23.Env.nonci.ID }}", enabled: true, feature: "feature1") {
    enabled
  }
}

RETURNS

ENDOPTS

{
	"data": {
		"testing": {
			"enabled": true
		},
		"mgmt": {
			"enabled": true
		},
		"nonci": {
			"enabled": true
		}
	}
}
